# ==============================================================================
# Facility Distance & Routing Engine - Environment Configuration
# ==============================================================================

# OSRM Service Base URL (defaults to public demo server if not specified, self-hosted OSRM recommended in production)
OSRM_BASE_URL=https://router.project-osrm.org

# Routing HTTP Request Timeout in milliseconds
OSRM_TIMEOUT_MS=6000

# Nominatim Geocoding Base URL
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Nominatim Required User-Agent (must identify your application according to OSM policy)
NOMINATIM_USER_AGENT=FacilityDistanceEngine/1.0 (contact@healthrouting.org)

# Geocoding Rate Limit Delay in milliseconds (minimum 1000ms recommended for OSM Nominatim)
NOMINATIM_RATE_LIMIT_MS=1000

# Route Cache Time-to-Live (TTL) in milliseconds (default: 30 minutes = 1800000 ms)
CACHE_TTL_MS=1800000

# Maximum in-memory cache entries
CACHE_MAX_ENTRIES=10000

# Maximum parallel routing requests during batch calculation
ROUTING_CONCURRENCY_LIMIT=5

# Default routing profile (supported: driving, walking, cycling)
DEFAULT_ROUTING_PROFILE=driving

# Logging level: debug | info | warn | error
LOG_LEVEL=info
