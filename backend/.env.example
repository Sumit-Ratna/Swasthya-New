# ==============================================================================
# SwasthyaSetu Backend Environment Configuration (.env.example)
# Note: Platform environment variables must be supplied in hosting dashboard.
# NEVER commit real production secret keys to version control!
# ==============================================================================

# ----------------- Server Runtime -----------------
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# ----------------- Security & Authentication -----------------
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters

# ----------------- Database & Identity (Supabase PostgreSQL) -----------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ----------------- AI Decision Support Microservice -----------------
AI_SERVICE_URL=http://127.0.0.1:8001
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ----------------- CORS & Network Access -----------------
# Comma-separated allowlist of origins or '*' for open staging
CORS_ORIGIN=*

# ----------------- Governance & Audit Ledger -----------------
ENABLE_AUDIT_CHAIN=true

# ----------------- SMS & Notifications (Twilio / Mock) -----------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ----------------- SMTP & Password Reset Email Service -----------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_or_smtp_username@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Swasthya Health" <no-reply@swasthya.org>
FRONTEND_URL=https://swasthya-zeta.vercel.app
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_OTP_TTL_MINUTES=15

