# ==============================================================================
# SwasthyaSetu Root Environment Configuration Template (.env.example)
# Note: Platform environment variables must be supplied in hosting dashboard.
# NEVER commit real production secret keys to version control!
# ==============================================================================

# ----------------- Server Runtime -----------------
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# ----------------- Security & Authentication -----------------
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters

# ----------------- Database & Identity (Supabase PostgreSQL) -----------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ----------------- AI Decision Support Microservice -----------------
AI_SERVICE_URL=http://127.0.0.1:8001
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ----------------- Frontend & Client Integration -----------------
VITE_API_URL=http://localhost:8000
CORS_ORIGIN=*

# ----------------- Governance & Audit -----------------
ENABLE_AUDIT_CHAIN=true

# ----------------- SMS & Notifications (Twilio / Mock) -----------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ----------------- Email Delivery (SMTP / Nodemailer) -----------------
# Provide your SMTP server credentials for real production email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_or_smtp_key
FROM_EMAIL=Swasthya Health <no-reply@swasthya.org>
APP_URL=http://localhost:5173
